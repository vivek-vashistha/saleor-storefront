# Database
postgres_url="your-postgres-url"
postgres_username="your-postgres-username"
postgres_password="your-postgres-password"
postgres_port=5432
postgres_database="your-database-name"

# API Keys
groq_api_key="your-groq-api-key"
openai_api_key="your-openai-api-key"
open_ai_api_model_name="gpt-4o"
open_ai_api_version="2024-02-15-preview"
open_ai_api_endpoint="https://your-azure-openai-endpoint.cognitiveservices.azure.com/"
WEATHER_API_KEY="your-weather-api-key"

# Neo4j
NEO4J_URI="neo4j+s://your-neo4j-instance.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"
AURA_INSTANCEID="your-instance-id"
AURA_INSTANCENAME="your-instance-name"
NEO4J_VECTOR_INDEX_NAME="productEmbedding"
NEO4J_FULLTEXT_INDEX_NAME="productFulltext"

# Direct OpenAI (optional)
DIRECT_OPENAI_API_KEY="your-direct-openai-api-key"
# OPENAI_MODEL = 'gpt-4o-mini'
OPENAI_MODEL="gpt-4o"
LANGSMITH_API_KEY="your-langsmith-api-key"

# Turing / Saleor
SALEOR_TOKEN="your-saleor-token"
SALEOR_ENDPOINT="https://your-saleor-endpoint/graphql/"
CHANNEL_SLUG="default-channel"
CHANNEL_SLUG_channel_pln="channel-pln"

# Local API
# API_BASE_URL=http://localhost:8000

# Defaults
DEFAULT_MODEL=openai_gpt_4o
DEFAULT_MODE=graph_vector_fulltext
ORDER_GRAPH_API_URL=http://localhost:8000/v1/saleor/orders
ORDER_GRAPH_TIMEOUT=120
